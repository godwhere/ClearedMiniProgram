.home { padding-top: 120rpx; }
.hero { text-align: center; margin-bottom: 72rpx; }
.logo { display: block; color: #1976a8; font-size: 88rpx; font-weight: 700; letter-spacing: 2rpx; }
.subtitle { display: block; margin-top: 24rpx; color: #667684; font-size: 28rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 36rpx; box-shadow: 0 10rpx 32rpx rgba(33, 55, 70, .08); }
.card-title { display: block; font-size: 36rpx; font-weight: 600; }
.card-copy { display: block; margin-top: 14rpx; color: #667684; font-size: 27rpx; line-height: 1.6; }
