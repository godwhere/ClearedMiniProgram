.play-page { padding: 24rpx 20rpx 48rpx; }
.play-header { display: flex; justify-content: space-between; align-items: center; padding: 8rpx 8rpx 24rpx; }
.level-title { display: block; font-size: 38rpx; font-weight: 700; }
.set-title { display: block; color: #7b8993; font-size: 24rpx; margin-top: 4rpx; }
.timer { color: #1976a8; font-size: 42rpx; font-variant-numeric: tabular-nums; }
.board-wrap { display: flex; justify-content: center; align-items: center; background: #fff; border-radius: 26rpx; padding: 12rpx; box-shadow: 0 10rpx 28rpx rgba(33, 55, 70, .08); }
.board { display: block; }
.complete-banner { color: #fff; background: #4e9a65; border-radius: 16rpx; text-align: center; padding: 18rpx; margin-top: 24rpx; font-size: 30rpx; }
.actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.action-button { flex: 1; margin: 0; padding: 0; height: 82rpx; line-height: 82rpx; border-radius: 16rpx; color: #1c536f; background: #e2f0f7; font-size: 28rpx; }
.action-button[disabled] { color: #aebbc2; background: #e9edef; }
