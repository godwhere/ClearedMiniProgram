    { "id": "large-v1-8x8-01", "smoke": true, "brief": { "schemaVersion": 1, "mechanic": "ordinary", "width": 8, "height": 8, "colorCount": 8, "targetGrade": 1, "designIntent": "八乘八入门题，第一步明确，整体舒展快速。" } },
