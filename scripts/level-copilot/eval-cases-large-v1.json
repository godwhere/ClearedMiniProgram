    { "id": "large-v1-8x8-05", "smoke": false, "brief": { "schemaVersion": 1, "mechanic": "ordinary", "width": 8, "height": 8, "colorCount": 8, "targetGrade": 2, "designIntent": "先完成两条短线，再出现一次中段空间判断。" } },
