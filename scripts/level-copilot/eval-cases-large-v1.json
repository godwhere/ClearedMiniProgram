    { "id": "large-v1-7x7-01", "smoke": true, "brief": { "schemaVersion": 1, "mechanic": "ordinary", "width": 7, "height": 7, "colorCount": 7, "targetGrade": 1, "designIntent": "七乘七入门题，配对清楚，多数线路短而直接。" } },
